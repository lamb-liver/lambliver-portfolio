{
  "name": "lambliver-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "羊肝（lambliver）個人作品集 — Next.js App Router",
  "repository": {
    "type": "git",
    "url": "https://github.com/lamb-liver/lambliver-portfolio.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run validate && npm run test && next build --webpack && node scripts/inline-critical-css.mjs",
    "start": "next start",
    "validate": "tsx scripts/validate-skills.ts",
    "test": "vitest run",
    "lint": "eslint",
    "analyze": "ANALYZE=true next build --webpack"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "dependencies": {
    "critters": "^0.0.23",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
